  </ItemGroup>
  <ItemGroup>
    <None Remove="C:\Users\dan\.nuget\packages\vosk\0.3.38\build\lib\win-x64\libvosk.dll" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="C:\Users\dan\.nuget\packages\vosk\0.3.38\build\lib\win-x64\libwinpthread-1.dll" />
  </ItemGroup>
</Project>